# Telegram 机器人
BOT_TOKEN=replace_with_telegram_bot_token
# 机器人用户名，不含 @
BOT_USERNAME=your_bot_username

# Telegram 与网站的接头暗号：换成随机字符串，Vercel 和注册 Webhook 时填同一个值
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret

# 允许操作的 Telegram 用户 ID，多个用逗号分隔
ALLOWED_TELEGRAM_IDS=123456789

# Bybit 正式网密钥（真实资金，需现货交易权限）
API_KEY=replace_with_bybit_mainnet_key
API_SECRET=replace_with_bybit_mainnet_secret